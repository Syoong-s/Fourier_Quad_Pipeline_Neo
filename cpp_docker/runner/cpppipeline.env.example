# One OCI image and one SIF are used at every supported HPC site.
# Pin OCI_IMAGE_URI by digest for production deployments.
OCI_IMAGE_URI=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_ME
CPP_DOCKER_ARCHIVE=/shared/path/to/cpppipeline-gxx12.3-openmpi4.1.8-pmi2.docker.tar
CPP_SIF=/shared/path/to/cpppipeline-gxx12.3-openmpi4.1.8-pmi2.sif
CPP_SIF_SHA256_EXPECTED=

CPP_SOURCE_HOST=/path/to/cpp_Standard
CPP_SOURCE_CONTAINER=/workspace/src_pipe

#SCIENCE_ROOT_HOST=/path/to/science/archive
#SCIENCE_ROOT_CONTAINER=/data/archive/science

#DQ_ROOT_HOST=/path/to/dqmask/archive
#DQ_ROOT_CONTAINER=/data/archive/dqmask

ASTROMETRY_CAT_HOST=/path/to/astrometry/catalog
ASTROMETRY_CAT_CONTAINER=/data/catalogs/AstroDir

SOURCE_CAT_HOST=/path/to/source/catalog
SOURCE_CAT_CONTAINER=/data/catalogs/ExtSrcDir

FLAT_PATH_HOST=/path/to/flat/calibration
FLAT_PATH_CONTAINER=/data/calib/FlatDir

PROCESS_DATA_HOST=/path/to/processing/data
PROCESS_DATA_CONTAINER=/data/DataProcess
CPP_EXPO_LIST_CONTAINER="${PROCESS_DATA_CONTAINER%/}/expo_list.list"

# Optional: pipeline mounts.  All six are optional.  Set *_HOST variables
# only for the mounts you need; unset variables are simply not bound.
# When absent, the pipeline falls back to defaults under PROCESS_DATA
# (already writable), or the process stage is not run.
#
#EXTCAT_INPUT_HOST=/path/to/extcat/input
#EXTCAT_INPUT_CONTAINER=/data/catalogs/ExtCatInput
#REARR_OUTPUT_HOST=/path/to/rearr/output
#REARR_OUTPUT_CONTAINER=/data/output/rearr
#EXPOLIST_DIR_HOST=/path/to/expolist
#EXPOLIST_DIR_CONTAINER=/data/output/expolist
#FD_OUTPUT_HOST=/path/to/fd/output
#FD_OUTPUT_CONTAINER=/data/output/fdout

HPC_SHARED_SCRATCH_HOST="${PROCESS_DATA_HOST}"

APPTAINER_BIN=
APPTAINER_CACHE_DIR=/shared/path/to/apptainer-cache
APPTAINER_TMP_DIR=/shared/path/to/apptainer-tmp
HPC_EXTRA_BINDS=()

CPP_IMAGE_ID_EXPECTED=gxx12.3-openmpi4.1.8-pmi2
CPP_GXX_VERSION_EXPECTED=12.3.0
CPP_OPENMPI_VERSION_EXPECTED=4.1.8

# Modules may initialize Slurm or Apptainer, but must not inject a host MPI.
HPC_MODULES=()
SITE_ENV_SCRIPT=
MPI_LAUNCH_MODE=srun
SLURM_MPI_TYPE=pmi2
SRUN_ARGS=()

# The runner starts from --cleanenv, forwards all SLURM_* and PMI_* variables,
# and then forwards only the explicitly named or assigned values below.
HPC_SCRUB_MPI_ENV=1
HPC_PASSTHROUGH_ENV=(OMP_NUM_THREADS)
HPC_CONTAINER_ENV=()

CPP_BUILD_JOBS=4
CPP_MAKE_CLEAN=1
CPP_EXECUTABLE="${CPP_SOURCE_CONTAINER%/}/Fourier_Quad_Pipe"
